CONFIG_ENV=config.env
KERNEL_SOURCE=https://github.com/aaabbk/android_kernel_xiaomi_mt6873-hlm
KERNEL_SOURCE_BRANCH=miui13
KERNEL_CONFIG=vendor/bomb_user_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64
EXTRA_CMDS=
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
CUSTOM_CMDS=
CLANG_BRANCH=ten
CLANG_VERSION=clang-r383902b
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=
ENABLE_KERNELSU=false
KERNELSU_TAG=
ADD_KPROBES_CONFIG=false
DISABLE-LTO=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_CC_WERROR=true
ENABLE_CCACHE=true
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
ENABLE_LXC=false
DISABLE_FST=false
ENABLE_NETHUNTER=false
